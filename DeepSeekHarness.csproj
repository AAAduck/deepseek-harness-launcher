<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeepSeekHarness</AssemblyName>
    <RootNamespace>DeepSeekHarness</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 应用清单：asInvoker（不弹 UAC）、supportedOS 声明、DPI 模式、长路径感知。
         缺清单时 Windows 会把程序当旧版本对待，DPI 与长路径行为都不确定。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 发布设置内置：这样 `dotnet publish -c Release` 一条命令就能产出可直接分发的
         单文件自包含 exe（同学无需安装 .NET 运行时）。不写在这里的话，
         参数只存在于发布者的命令行里，别人 clone 下来重建会得到一个需要 .NET 的版本。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 必须是 true：设成 false 后发布不再产出单个 exe，而是 exe + 6 个散落的原生库
         （实测：D3DCompiler_47_cor3.dll / PenImc_cor3.dll / PresentationNative_cor3.dll /
         vcruntime140_cor3.dll / wpfgfx_cor3.dll …）。那会直接推翻 README 里
         "自包含单文件、直接分发给同学即可" 的承诺——同学只拷 exe 就会启动失败。
         实测窗口出现时间 3.74 秒，收益也不足以抵掉这个分发风险。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- DPI 感知模式。必须写在这里，不能写在 app.manifest 里：UseWindowsForms 生成的
         ApplicationConfiguration.Initialize() 会调用 Application.SetHighDpiMode，
         与清单声明同时存在会打架（编译期 WFAC010，且运行时以先初始化的那处为准）。
         SystemAware 与原先清单里的 <dpiAwareness>System</dpiAwareness> 等价：
         系统 DPI 变化时由 WinForms 按比例重排控件，而不是让 Windows 拉伸整个窗口位图
         （后者会让中文变糊）。配合各窗体的 AutoScaleMode.Dpi 使用。 -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>

    <!-- exe 属性（右键→属性 里能看到），分发给同学时便于确认版本 -->
    <Version>1.4.0</Version>
    <AssemblyTitle>DeepSeek Harness 控制台</AssemblyTitle>
    <Product>DeepSeek Harness Launcher</Product>
    <Company>DeepSeek Harness Launcher</Company>
  </PropertyGroup>

  <!-- 调试符号只在 Release 产物里剔除；原先无条件 none，连本地 Debug 调试
       都拿不到异常堆栈里的行号，排查启动器自身的问题等于蒙眼。
       （PropertyGroup 不能嵌套，必须与主组平级。） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- tests\ 下的代码属于测试工程，绝不能被本项目默认的 **/*.cs 通配吃进来：
       被编进 WinExe 的话，启动时会因找不到 xunit 程序集而直接起不来。

       这里用 DefaultItemExcludes 把整个 tests\ 目录（连同它下面的 bin\obj 产物，
       实测三百多个文件）从**所有**默认通配里摘掉，而不只是 Compile 一项：
       只挡 .cs 的话，那些产物仍会被逐个建成 None 项参与拷贝判定；更要命的是
       将来谁在 tests\ 下放一个 .resx，本项目是 WinForms（**/*.resx 默认进
       EmbeddedResource），它就会被直接编进启动器的资源里。 -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- 上一条是"把整个 tests\ 从所有默认通配里摘掉"，但它能不能生效取决于 SDK 在
         props 还是 targets 里求值默认通配——这是跨 SDK 版本的隐式依赖，一旦哪天
         提前了，这条排除会**静默变成空操作**，主 WinExe 就把 tests\**\*.cs 编进去，
         启动时报"找不到 xunit 程序集"。所以这里保留 Compile Remove 作为不依赖
         求值顺序的兜底：两条同时在，任一条失效都还有另一条。 -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!-- 单测要直接跑几个 internal 纯函数：进程匹配内核、快照判定、恢复路径守卫、
       semver 范围判定。它们默认对外部程序集不可见，这里只对配套测试开口子。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DeepSeekHarness.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
